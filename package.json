{
    "name": "hello_world",
    "version": "1.0.0",
    "description": "Hello world in Node.js",
    "main": "server.js",
    "engines": {
        "node": ">=18"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": ">=22.12.0",
            "onFail": "warn"
        }
    },
    "scripts": {
        "start": "node server.js",
        "test": "echo \"Error: no test specified\" && exit 1",
        "docs:preflight": "node tools/check-doc-runtime.js",
        "docs:api": "node tools/check-doc-runtime.js && jsdoc -c jsdoc.json",
        "docs:md": "node tools/check-doc-runtime.js && node -e \"require('fs').mkdirSync('docs/api/generated', { recursive: true })\" && npm ci --ignore-scripts --prefix tools/docs-md && node tools/docs-md/node_modules/.bin/jsdoc2md --files server.js > docs/api/generated/server-module.md",
        "docs:lint": "node tools/check-doc-runtime.js && markdownlint-cli2",
        "docs:links": "node tools/check-links.js",
        "docs:check": "npm run docs:lint && npm run docs:links"
    },
    "devDependencies": {
        "jsdoc": "4.0.5",
        "markdown-link-check": "3.15.0",
        "markdownlint-cli2": "0.23.2"
    },
    "author": "hxu",
    "license": "MIT",
    "overrides": {
        "encoding-sniffer": "^1.0.2"
    }
}
