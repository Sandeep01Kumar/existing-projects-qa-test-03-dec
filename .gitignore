# Installed npm packages. Materialised by `npm install` from package-lock.json,
# which resolves the documentation toolchain declared in devDependencies
# (jsdoc, markdownlint-cli2, markdown-link-check). Reproducible, so never committed.
node_modules/

# Generated JSDoc output. Written here by `npm run docs:api` and `npm run docs:md`
# from the annotations in server.js. Build product only: the authored documentation
# under docs/ is committed instead, and no authored link ever points in here.
docs/api/generated/
